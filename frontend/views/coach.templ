package views

// CoachPage is the AI Coach chat page.
//
// How the conversation is remembered: every finished chat bubble carries two
// hidden inputs (role + content). The form includes them with hx-include, so
// each new question is sent together with the earlier turns. The page itself
// is the state - the server stores nothing. (When accounts arrive, chats move
// to the database.)
//
// One chat turn has two requests:
//  1. hx-post /coach/chat      -> the question bubble + an empty coach bubble
//  2. the coach bubble opens   -> GET /coach/stream/{id} (Server-Sent Events)
//     and the answer streams in piece by piece.
//
// While an answer streams, the form is locked (fieldset disabled). The SSE
// extension fires htmx:sseClose when the stream ends, and /static/js/app.js
// unlocks the form. (That code used to be in hx-on attributes; it moved to a
// file so the Content-Security-Policy can forbid inline scripts.)
templ CoachPage(model string) {
	@Layout("AI Coach") {
		<section class="chat">
			<header class="chat-header">
				<div>
					<h1>AI Coach</h1>
					<p class="muted">Ask about food, calories, protein or healthy habits.</p>
				</div>
				<span class="badge" title="AI model in use">{ model }</span>
			</header>
			<div id="messages" class="messages" aria-live="polite">
				<!-- The welcome bubble has no hidden inputs, so it is not sent to the model. -->
				<div class="bubble assistant">
					Hi! I'm your NutriSI coach. What would you like to know about nutrition today?
				</div>
			</div>
			<div id="chat-error"></div>
			<!--
				hx-post         send the form to /coach/chat
				hx-include      also send the hidden inputs inside #messages (the history)
				hx-target       put the answer into #messages...
				hx-swap         ...at the end, then scroll the end into view
				hx-disabled-elt disable the fieldset while the POST runs
				After a successful POST, app.js clears the box and keeps the form
				locked until the streamed answer is complete.
			-->
			<form
				id="chat-form"
				class="chat-form"
				hx-post="/coach/chat"
				hx-include="#messages"
				hx-target="#messages"
				hx-swap="beforeend show:bottom"
				hx-disabled-elt="#ask"
			>
				<fieldset id="ask">
					<label for="message" class="visually-hidden">Your question</label>
					<textarea
						id="message"
						name="message"
						rows="2"
						maxlength="2000"
						placeholder="e.g. How much protein is in 100 g of lentils?"
						required
						data-submit-on-enter
					></textarea>
					<button class="btn" type="submit">Send</button>
				</fieldset>
			</form>
			<p class="hint muted">Enter to send · Shift+Enter for a new line · Not medical advice.</p>
		</section>
	}
}

// ChatTurnStreaming is the answer to the POST: the user's question and an
// empty coach bubble that fills itself through Server-Sent Events.
//
//	hx-ext="sse"     turn on the SSE extension for this element
//	sse-connect      open an EventSource to this URL
//	sse-close="done" close the connection when the "done" event arrives
//	sse-swap="x"     when event "x" arrives, swap its data into this element
templ ChatTurnStreaming(question, streamID string) {
	@chatBubble("user", question)
	<div
		class="bubble assistant"
		hx-ext="sse"
		sse-connect={ "/coach/stream/" + streamID }
		sse-close="done"
	>
		<!-- Each "token" event is appended here; while empty, CSS shows "thinking". -->
		<div class="bubble-text stream" sse-swap="token" hx-swap="beforeend"></div>
		<!-- "final" replaces this placeholder with the hidden history inputs. -->
		<div sse-swap="final" hx-swap="outerHTML"></div>
		<!-- "failed" puts an error message here. -->
		<div sse-swap="failed" hx-swap="innerHTML"></div>
	</div>
	<!--
		Out-of-band swap: htmx also finds this element and replaces #chat-error
		with it, which clears any old error message. One response, two updates.
	-->
	<div id="chat-error" hx-swap-oob="true"></div>
}

templ chatBubble(role, text string) {
	<div class={ "bubble", role }>
		@HistoryInputs(role, text)
		<!-- templ escapes text, so a message can never inject HTML or scripts. -->
		<div class="bubble-text">{ text }</div>
	</div>
}

// HistoryInputs are the hidden fields that make a bubble part of the history.
templ HistoryInputs(role, text string) {
	<input type="hidden" name="role" value={ role }/>
	<input type="hidden" name="content" value={ text }/>
}

// ChatError is shown in #chat-error (or inside a coach bubble) when something
// goes wrong.
templ ChatError(msg string) {
	<div class="alert" role="alert">{ msg }</div>
}
