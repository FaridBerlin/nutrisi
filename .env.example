# Copy this file to .env and adjust. .env is git-ignored.

PORT=8080
APP_ENV=development   # development | production

# --- AI Coach model (any OpenAI-compatible server) ---
# Local Ollama:
LLM_BASE_URL=http://localhost:11434
# Fast, for development:        qwen3.5:0.8b
# Better answers, slower (CPU): qwen3.5:9b  or  gemma4:e4b
# Ollama cloud (fast, needs `ollama signin`, data leaves your PC): gpt-oss:20b-cloud
LLM_MODEL=qwen3.5:2b 
# "none" turns off the model's thinking step: much faster on a CPU.
# Leave empty to use the model's default.
LLM_REASONING_EFFORT=none
# Max time for one answer, e.g. 90s, 3m
LLM_TIMEOUT=3m
# Only needed for hosted APIs; local Ollama needs no key.
LLM_API_KEY=

# Later, llama.cpp instead of Ollama (llama-server uses port 8080 by default,
# so start it with --port 8081 or change PORT above):
# LLM_BASE_URL=http://localhost:8081
# LLM_MODEL=<the model name llama-server reports>

# --- Logging ---
# debug | info | warn | error. Text lines in development, JSON in production.
LOG_LEVEL=info

# --- Rate limits per client IP (0 = off) ---
# AI Coach questions per hour (bursts of up to 10 are allowed).
RATE_LIMIT_COACH_PER_HOUR=30
# All other requests per minute (static files and /healthz are never limited).
RATE_LIMIT_GENERAL_PER_MIN=120
